  "keyFeatures": [
    "Virtual account creation and management",
    "Domestic and cross-border money transfers",
    "Real-time webhook event notifications",
    "Account balance and transaction history",
    "Multi-currency support for African markets",
    "Secure API key authentication",
    "Idempotent requests for safe retries",
