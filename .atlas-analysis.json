  "publicApiSurface": [
    "POST /virtual-accounts — Create a virtual account",
    "GET /virtual-accounts/:id — Retrieve a virtual account",
    "POST /transfers — Initiate a transfer",
    "GET /transfers/:id — Get transfer status",
    "GET /transactions — List transactions",
    "GET /transactions/:id — Get transaction details",
    "GET /balance — Retrieve account balance",
    "POST /webhooks — Register a webhook endpoint",
    "GET /webhooks — List webhook subscriptions",
    "DELETE /webhooks/:id — Remove a webhook"
